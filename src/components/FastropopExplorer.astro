---
import ptaData from '../data/pta-violins.json';
---
<section class="fr-lab" id="fastropop-explorer">
  <div class="fr-lab__head">
    <div><span class="eyebrow">fastropop population lab</span><h2>Build a black-hole-binary population</h2><p>Change the merger-rate law and watch the PTA source population and its ensemble gravitational-wave background respond.</p></div>
    <div class="fr-lab__metric"><span>expected PTA-band sources</span><strong data-count>—</strong></div>
  </div>
  <div class="fr-lab__body">
    <form class="fr-lab__controls">
      <div class="control"><label for="fr-n0">log<sub>10</sub> ṅ<sub>0</sub><output data-out="n0">−3.00</output></label><input id="fr-n0" data-key="n0" type="range" min="-5" max="0" step="0.05" value="-3"><small>Gpc⁻³ Gyr⁻¹ · overall rate</small></div>
      <div class="control"><label for="fr-alpha">α<sub>𝓜</sub><output data-out="alpha">0.00</output></label><input id="fr-alpha" data-key="alpha" type="range" min="-1.5" max="2" step="0.05" value="0"><small>mass-function slope</small></div>
      <div class="control"><label for="fr-mstar">log<sub>10</sub> 𝓜<sub>*</sub><output data-out="mstar">8.26</output></label><input id="fr-mstar" data-key="mstar" type="range" min="7" max="10" step="0.05" value="8.255"><small>solar masses · high-mass cutoff</small></div>
      <div class="control"><label for="fr-beta">β<sub>z</sub><output data-out="beta">2.00</output></label><input id="fr-beta" data-key="beta" type="range" min="-1" max="5" step="0.05" value="2"><small>redshift evolution</small></div>
      <div class="control"><label for="fr-z0">z<sub>0</sub><output data-out="z0">1.80</output></label><input id="fr-z0" data-key="z0" type="range" min="0.4" max="4" step="0.05" value="1.8"><small>redshift cutoff</small></div>
      <div class="fr-lab__buttons"><button type="button" data-reset>Reset model</button><button type="button" data-redraw>New realization</button></div>
    </form>
    <div class="fr-lab__plots">
      <div class="plot-card"><div class="plot-title"><span>PTA-band population</span><strong data-pop-title>source abundance</strong></div><div class="pta-select"><label>View <select data-pop-mode><option value="count">Source abundance</option><option value="signal">GW contribution</option></select></label></div><canvas data-pop width="620" height="390" role="img" aria-label="Mass and redshift distribution of the selected supermassive black-hole-binary population"></canvas><p class="hint" data-pop-hint>d²N / d log₁₀𝓜 dz · integrated over the PTA band</p></div>
      <div class="plot-card"><div class="plot-title"><span>PTA signal</span><strong>h<sub>c</sub>(f)</strong></div><div class="pta-select"><label>PTA data <select data-pta><option value="nanograv15">NANOGrav 15 yr</option><option value="none">None</option></select></label></div><svg data-spectrum viewBox="0 0 620 390" role="img" aria-label="Ensemble and discrete characteristic strain spectra with PTA free-spectrum posterior"><defs><clipPath id="fastropop-spectrum-clip"><rect x="66" y="28" width="536" height="312" /></clipPath></defs><g data-grid></g><g clip-path="url(#fastropop-spectrum-clip)"><g data-violins></g><path data-current></path><path data-discrete></path><g data-discrete-points></g></g><text x="76" y="18" class="plot-label">characteristic strain</text><text x="334" y="377" text-anchor="middle" class="plot-label">frequency / Hz</text></svg><div class="legend"><span class="current">ensemble mean</span><span class="discrete">one realization</span><span class="pta">NANOGrav posterior</span></div><p class="hint">Circular, GW-driven binaries · Poisson population realization</p></div>
    </div>
  </div>
  <p class="fr-lab__note">The five controls define the semi-analytic mass–redshift population in <code>fastropop.SemiAnalyticPopulation</code>. The upper map can show either where PTA-band binaries are most numerous or where they contribute most strongly to the strain; massive nearby systems are rarer but individually louder. The lower plot contrasts the ensemble-mean background with one finite Poisson realization, revealing the bin-to-bin structure produced by discrete sources. A small z &lt; 10<sup>−4</sup> cutoff regularizes the idealized model’s divergent nearest-source variance.</p>
  <script is:inline type="application/json" data-pta-json set:html={JSON.stringify(ptaData)}></script>
</section>

<script>
  (()=>{
    const found=document.getElementById('fastropop-explorer');if(!found)return;const root=found;
    const canvas=root.querySelector<HTMLCanvasElement>('[data-pop]')!,ctx=canvas.getContext('2d')!;
    const svg=root.querySelector<SVGElement>('[data-spectrum]')!;
    const defaults={n0:-3,alpha:0,mstar:Math.log10(1.8e8),beta:2,z0:1.8};
    const baseline={hc2:5.176145820705626e-30,count:144757251830.49512};let drawSeed=31721;const violinData=JSON.parse(root.querySelector('[data-pta-json]')?.textContent||'{}');
    const W=620,H=390,L=66,R=18,T=28,B=50;
    const inputs=Object.fromEntries(Array.from(root.querySelectorAll<HTMLInputElement>('input[data-key]')).map(el=>[el.dataset.key!,el]));
    const params=()=>Object.fromEntries(Object.entries(inputs).map(([k,el])=>[k,Number(el.value)])) as Record<string,number>;
    const lin=(a:number,b:number,n:number)=>Array.from({length:n},(_,i)=>a+(b-a)*i/(n-1));
    const trap=(xs:number[],ys:number[])=>ys.slice(1).reduce((s,y,i)=>s+(y+ys[i])*(xs[i+1]-xs[i])/2,0);
    const cosmology=(()=>{const z=lin(0,5,241),E=z.map(v=>Math.sqrt(.3*(1+v)**3+.7)),dc=[0];for(let i=1;i<z.length;i++)dc.push(dc[i-1]+.5*(1/E[i-1]+1/E[i])*(z[i]-z[i-1]));return{z,E,dc};})();
    const massIntegral=(p:Record<string,number>,kind:'hc'|'count')=>{const x=lin(6,11,241),ms=10**p.mstar;return trap(x,x.map(v=>{const m=10**v,law=(m/1e7)**(-p.alpha)*Math.exp(-m/ms);return kind==='hc'?m**(5/3)*law:m**(-5/3)*law;}));};
    const zIntegral=(p:Record<string,number>,kind:'hc'|'count')=>trap(cosmology.z,cosmology.z.map((z,i)=>kind==='hc'?(1+z)**(p.beta-4/3)*Math.exp(-z/p.z0)/cosmology.E[i]:cosmology.dc[i]**2*(1+z)**(p.beta-8/3)*Math.exp(-z/p.z0)/cosmology.E[i]));
    const baseMassH=massIntegral(defaults,'hc'),baseMassN=massIntegral(defaults,'count'),baseZH=zIntegral(defaults,'hc'),baseZN=zIntegral(defaults,'count');
    const ratios=(p:Record<string,number>)=>{const norm=10**(p.n0-defaults.n0);return{hc2:norm*massIntegral(p,'hc')/baseMassH*zIntegral(p,'hc')/baseZH,count:norm*massIntegral(p,'count')/baseMassN*zIntegral(p,'count')/baseZN};};
    const formatCount=(v:number)=>v>=1e9?(v/1e9).toFixed(v<1e10?1:0)+'B':v>=1e6?(v/1e6).toFixed(1)+'M':v.toPrecision(3);
    function drawPopulation(p:Record<string,number>,r:{hc2:number,count:number}){
      const mode=root.querySelector<HTMLSelectElement>('[data-pop-mode]')!.value,css=getComputedStyle(root),ink=css.getPropertyValue('--ink').trim(),paper=css.getPropertyValue('--paper-deep').trim(),signal=css.getPropertyValue('--signal').trim(),soft=css.getPropertyValue('--signal-soft').trim();ctx.clearRect(0,0,W,H);ctx.fillStyle=paper;ctx.fillRect(0,0,W,H);
      const PL=66,PR=64,PB=50,pw=W-PL-PR,ph=H-T-PB,nx=120,ny=100,zs=lin(0,5,nx),ms=lin(6,11,ny),raw:number[]=[];let norm=0;const dx=5/(ny-1),dz=5/(nx-1);
      for(let j=0;j<ny;j++)for(let i=0;i<nx;i++){const z=zs[i],m=10**ms[j],ci=Math.min(cosmology.z.length-1,Math.round(z/5*(cosmology.z.length-1))),dc=cosmology.dc[ci],law=(m/1e7)**(-p.alpha)*Math.exp(-m/10**p.mstar);let v;if(mode==='count')v=m**(-5/3)*law*dc**2/cosmology.E[ci]*(1+z)**(p.beta-8/3)*Math.exp(-z/p.z0);else v=m**(5/3)*law/cosmology.E[ci]*(1+z)**(p.beta-4/3)*Math.exp(-z/p.z0);raw.push(v);norm+=v*dx*dz;}
      const total=mode==='count'?baseline.count*r.count:baseline.hc2*r.hc2,lo=mode==='count'?3:-35,hi=mode==='count'?14:-27,rgb=(hex:string)=>{const h=hex.replace('#','');return[parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)]},colors=[rgb(paper),rgb(soft),rgb(signal),rgb(ink)],colour=(q:number)=>{const x=Math.max(0,Math.min(.999,q))*3,k=Math.floor(x),t=x-k;return colors[k].map((v,i)=>v+(colors[k+1][i]-v)*t)};
      const image=ctx.createImageData(pw,ph);for(let y=0;y<ph;y++)for(let x=0;x<pw;x++){const i=Math.min(nx-1,Math.floor(x/pw*nx)),j=Math.min(ny-1,Math.floor((1-y/ph)*ny)),log=Math.log10(Math.max(total*raw[j*nx+i]/norm,10**(lo-2))),c=colour((log-lo)/(hi-lo)),k=(y*pw+x)*4;image.data[k]=c[0];image.data[k+1]=c[1];image.data[k+2]=c[2];image.data[k+3]=255;}ctx.putImageData(image,PL,T);
      ctx.strokeStyle='rgba(24,35,40,.14)';ctx.fillStyle=ink;ctx.font='11px ui-monospace,monospace';ctx.textAlign='center';[0,1,2,3,4,5].forEach(z=>{const x=PL+z/5*pw;ctx.beginPath();ctx.moveTo(x,T);ctx.lineTo(x,H-PB);ctx.stroke();ctx.fillText(String(z),x,H-PB+20)});ctx.textAlign='right';[6,7,8,9,10,11].forEach(m=>{const y=T+(11-m)/5*ph;ctx.beginPath();ctx.moveTo(PL,y);ctx.lineTo(PL+pw,y);ctx.stroke();ctx.fillText(String(m),PL-9,y+4)});ctx.textAlign='center';ctx.fillText('REDSHIFT Z',(PL+W-PR)/2,H-10);ctx.save();ctx.translate(15,(T+H-PB)/2);ctx.rotate(-Math.PI/2);ctx.fillText('LOG₁₀ CHIRP MASS / M☉',0,0);ctx.restore();
      const barX=W-43,barY=T,barW=12,barH=ph;for(let y=0;y<barH;y++){const c=colour(1-y/(barH-1));ctx.fillStyle=`rgb(${c[0]},${c[1]},${c[2]})`;ctx.fillRect(barX,barY+y,barW,1)}ctx.strokeStyle='rgba(24,35,40,.25)';ctx.strokeRect(barX,barY,barW,barH);ctx.fillStyle=ink;ctx.font='9px ui-monospace,monospace';ctx.textAlign='left';[hi,(hi+lo)/2,lo].forEach((v,i)=>ctx.fillText(`10^${v}`,barX+16,barY+i*barH/2+3));
      root.querySelector('[data-pop-title]')!.textContent=mode==='count'?'source abundance':'GW contribution';root.querySelector('[data-pop-hint]')!.textContent=mode==='count'?'d²N / d log₁₀𝓜 dz · integrated over the PTA band':'d²h_c² / d log₁₀𝓜 dz · evaluated at 1 yr⁻¹';
    }
    const lx=(x:number)=>L+(Math.log10(x)+9)/2.2*(W-L-R),ly=(y:number)=>T+(1-(Math.log10(y)+16.5)/3.5)*(H-T-B),freqs=lin(0,1,90).map(q=>10**(-9+2.2*q));
    const curve=(amp:number)=>freqs.map((f,i)=>`${i?'L':'M'}${lx(f).toFixed(1)},${ly(amp*(f/(1/31557600))**(-2/3)).toFixed(1)}`).join(' ');
    const uniform=(index:number,salt:number)=>{const x=Math.sin((index+1)*12.9898+(drawSeed+salt)*78.233)*43758.5453;return Math.max(1e-12,x-Math.floor(x));};
    const poisson=(lambda:number,index:number)=>{if(lambda>30){const z=Math.sqrt(-2*Math.log(uniform(index,1)))*Math.cos(2*Math.PI*uniform(index,2));return Math.max(0,Math.round(lambda+Math.sqrt(lambda)*z));}const u=uniform(index,3);let k=0,p=Math.exp(-lambda),cdf=p;while(u>cdf&&k<100){k++;p*=lambda/k;cdf+=p;}return k;};
    function discreteSpectrum(p:Record<string,number>,meanRatio:number,countRatio:number){
      const mEdges=lin(6,11,45),mids=mEdges.slice(0,-1).map((x,i)=>(x+mEdges[i+1])/2),mweights=mids.map((x,i)=>{const m=10**x;return(m/1e7)**(-p.alpha)*Math.exp(-m/10**p.mstar)*m**(-5/3)*(mEdges[i+1]-mEdges[i])});
      const zEdges=[0,...lin(-4,Math.log10(5),49).map(x=>10**x)],zmids=zEdges.slice(0,-1).map((z,i)=>(z+zEdges[i+1])/2),zweights=zmids.map((z,i)=>{const ci=Math.min(cosmology.z.length-1,Math.round(z/5*(cosmology.z.length-1))),dc=Math.max(cosmology.dc[ci],z/Math.sqrt(.3*(1+z)**3+.7));return dc**2/cosmology.E[ci]*(1+z)**(p.beta-8/3)*Math.exp(-z/p.z0)*(zEdges[i+1]-zEdges[i])});
      const sm=mweights.reduce((a,b)=>a+b,0),sz=zweights.reduce((a,b)=>a+b,0),fmin=.5/(16*31557600),fmax=1e-7,fNorm=fmin**(-8/3)-fmax**(-8/3),values:number[]=[];
      for(let bin=0;bin<14;bin++){const flo=(2*bin+1)*fmin,fhi=(2*bin+3)*fmin,fc=(flo+fhi)/2,lambdaBin=baseline.count*countRatio*(flo**(-8/3)-fhi**(-8/3))/fNorm;let expected=0,realized=0,index=bin*mids.length*zmids.length;
        for(let i=0;i<mids.length;i++){const m=10**mids[i];for(let j=1;j<zmids.length;j++){const z=zmids[j],ci=Math.min(cosmology.z.length-1,Math.round(z/5*(cosmology.z.length-1))),dc=Math.max(cosmology.dc[ci],z/Math.sqrt(.3*(1+z)**3+.7)),lambda=lambdaBin*mweights[i]/sm*zweights[j]/sz,q=m**(10/3)*(1+z)**(4/3)/dc**2;expected+=lambda*q;realized+=poisson(lambda,index++)*q;}}
        const mean=baseline.hc2*meanRatio*(fc/(1/31557600))**(-4/3);values.push(Math.sqrt(mean*Math.max(realized/expected,1e-12)));
      }return values;
    }
    function drawViolins(name:string){const target=svg.querySelector('[data-violins]')!;if(name==='none'||!violinData[name]){target.innerHTML='';return;}target.innerHTML=violinData[name].bins.map((bin:any)=>{const right=bin.logStrain.map((s:number,i:number)=>`${i?'L':'M'}${lx(10**(bin.logFrequency+bin.halfWidth[i])).toFixed(1)},${ly(10**s).toFixed(1)}`).join(' '),left=bin.logStrain.map((_:number,j:number)=>{const i=bin.logStrain.length-1-j;return`L${lx(10**(bin.logFrequency-bin.halfWidth[i])).toFixed(1)},${ly(10**bin.logStrain[i]).toFixed(1)}`}).join(' ');return`<path d="${right} ${left} Z"/>`}).join('');}
    function setupSpectrum(){const grid=svg.querySelector('[data-grid]')!;grid.innerHTML=[1e-9,1e-8,1e-7].map(x=>`<line x1="${lx(x)}" y1="${T}" x2="${lx(x)}" y2="${H-B}"/><text x="${lx(x)}" y="${H-25}">${x.toExponential(0)}</text>`).join('')+[1e-16,1e-15,1e-14,1e-13].map(y=>`<line x1="${L}" y1="${ly(y)}" x2="${W-R}" y2="${ly(y)}"/><text x="${L-8}" y="${ly(y)+4}" text-anchor="end">${y.toExponential(0)}</text>`).join('');drawViolins('nanograv15');}
    function update(){const p=params(),r=ratios(p);Object.entries(p).forEach(([k,v])=>{const out=root.querySelector<HTMLOutputElement>(`[data-out="${k}"]`);if(out)out.textContent=v.toFixed(2).replace('-', '−')});root.querySelector('[data-count]')!.textContent=formatCount(baseline.count*r.count);drawPopulation(p,r);svg.querySelector('[data-current]')!.setAttribute('d',curve(Math.sqrt(baseline.hc2*r.hc2)));const discrete=discreteSpectrum(p,r.hc2,r.count),centers=Array.from({length:14},(_,i)=>(2*i+2)*(.5/(16*31557600)));svg.querySelector('[data-discrete]')!.setAttribute('d',discrete.map((v,i)=>`${i?'L':'M'}${lx(centers[i]).toFixed(1)},${ly(v).toFixed(1)}`).join(' '));svg.querySelector('[data-discrete-points]')!.innerHTML=discrete.map((v,i)=>`<circle cx="${lx(centers[i]).toFixed(1)}" cy="${ly(v).toFixed(1)}" r="3"/>`).join('');}
    Object.values(inputs).forEach(el=>el.addEventListener('input',update));root.querySelector('[data-redraw]')!.addEventListener('click',()=>{drawSeed=(drawSeed+7919)>>>0;update()});root.querySelector('[data-reset]')!.addEventListener('click',()=>{Object.entries(defaults).forEach(([k,v])=>inputs[k].value=String(v));update()});root.querySelector<HTMLSelectElement>('[data-pta]')!.addEventListener('change',e=>drawViolins((e.target as HTMLSelectElement).value));root.querySelector<HTMLSelectElement>('[data-pop-mode]')!.addEventListener('change',()=>{const p=params();drawPopulation(p,ratios(p))});setupSpectrum();update();
  })();
</script>

<style>
  .fr-lab{color:var(--ink);padding:clamp(1.2rem,3vw,2.2rem)}.fr-lab__head{align-items:end;display:flex;gap:2rem;justify-content:space-between;margin-bottom:1.4rem}.fr-lab__head>div:first-child{max-width:680px}.fr-lab h2{font-family:var(--serif);font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:400;letter-spacing:-.04em;margin:.25rem 0}.fr-lab__head p,.fr-lab__note{color:var(--ink-soft);line-height:1.55}.fr-lab__metric{text-align:right}.fr-lab__metric span{color:var(--ink-soft);display:block;font-family:var(--mono);font-size:.6rem;text-transform:uppercase}.fr-lab__metric strong{color:var(--signal);font-family:var(--serif);font-size:2rem;font-weight:400}.fr-lab__body{align-items:start;display:grid;gap:1rem;grid-template-columns:190px 1fr}.fr-lab__controls{background:rgba(244,241,234,.48);border:1px solid var(--line);display:flex;flex-direction:column;gap:1.05rem;padding:1rem}.control label{align-items:baseline;display:flex;font-family:var(--serif);font-size:.92rem;justify-content:space-between}.control output{color:var(--signal);font-family:var(--mono);font-size:.65rem}.control input{accent-color:var(--signal);display:block;margin:.35rem 0 .15rem;width:100%}.control small,.hint{color:var(--ink-soft);font-family:var(--mono);font-size:.55rem;text-transform:uppercase}.fr-lab__buttons{display:grid;gap:.45rem;margin-top:auto}.fr-lab button,.fr-lab select{background:transparent;border:1px solid var(--line);color:var(--ink);cursor:pointer;font-family:var(--mono);font-size:.57rem;padding:.55rem;text-transform:uppercase}.fr-lab button:hover,.fr-lab select:hover{border-color:var(--signal);color:var(--signal)}.fr-lab__plots{align-items:start;display:grid;gap:1px;grid-template-columns:1fr 1fr}.plot-card{background:rgba(244,241,234,.48);border:1px solid var(--line);min-width:0;overflow:hidden;padding:.8rem;position:relative}.plot-title{align-items:baseline;display:flex;justify-content:space-between}.plot-title span{color:var(--ink-soft);font-family:var(--mono);font-size:.57rem;text-transform:uppercase}.plot-title strong{font-family:var(--serif);font-size:1.05rem;font-weight:400}.pta-select{display:flex;justify-content:flex-end;margin:.45rem 0 -.35rem}.pta-select label{color:var(--ink-soft);font-family:var(--mono);font-size:.55rem;text-transform:uppercase}.pta-select select{margin-left:.35rem;padding:.32rem}.plot-card canvas,.plot-card svg{display:block;height:auto;width:100%}.plot-label{fill:var(--ink-soft);font-family:var(--mono);font-size:11px;text-transform:uppercase}[data-grid] :global(line){stroke:rgba(24,35,40,.1)}[data-grid] :global(text){fill:rgba(24,35,40,.58);font-family:var(--mono);font-size:11px}[data-violins] :global(path){fill:rgba(168,127,104,.3);stroke:rgba(168,127,104,.62);stroke-width:.7}[data-current]{fill:none;stroke:var(--signal);stroke-width:2;stroke-dasharray:5 5}[data-discrete]{fill:none;stroke:var(--ink);stroke-width:2}[data-discrete-points] :global(circle){fill:var(--paper);stroke:var(--ink);stroke-width:1.5}.legend{display:flex;flex-wrap:wrap;gap:.55rem 1rem;justify-content:flex-end;margin-top:-.15rem}.legend span{font-family:var(--mono);font-size:.53rem;text-transform:uppercase}.legend span:before{content:"";display:inline-block;height:2px;margin-right:.3rem;vertical-align:middle;width:14px}.legend .current:before{background:var(--signal)}.legend .discrete:before{background:var(--ink)}.legend .pta:before{background:var(--warm-signal);height:7px}.hint{margin:.55rem 0 0;text-align:right}.fr-lab__note{font-size:.68rem;margin:1rem 0 0}.fr-lab__note code{color:var(--signal)}@media(max-width:1050px){.fr-lab__body{grid-template-columns:1fr}.fr-lab__controls{display:grid;grid-template-columns:repeat(3,1fr)}.fr-lab__buttons{grid-column:span 3}.fr-lab__plots{gap:.7rem}}@media(max-width:720px){.fr-lab{padding:.9rem .15rem}.fr-lab__head{align-items:start;flex-direction:column}.fr-lab__metric{text-align:left}.fr-lab__plots{grid-template-columns:1fr}.fr-lab__controls{grid-template-columns:1fr 1fr}.fr-lab__buttons{grid-column:span 2}.plot-card{padding:.65rem}.pta-select{justify-content:flex-start;margin:.55rem 0 0}.plot-label,[data-grid] :global(text){font-size:13px}.hint{text-align:left}}@media(max-width:440px){.fr-lab__controls{grid-template-columns:1fr}.fr-lab__buttons{grid-column:auto}.plot-title{align-items:start;flex-direction:column;gap:.15rem}.legend{justify-content:flex-start}}
</style>
