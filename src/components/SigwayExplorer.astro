<section class="sig-lab" id="sigway-explorer">
  <div class="sig-lab__head"><div><span class="eyebrow">SIGWAY kernel lab</span><h2>Paint a primordial spectrum</h2><p>Draw the binned curvature spectrum. The induced gravitational-wave spectrum updates through SIGWAY’s precomputed bilinear kernel.</p></div><div class="sig-lab__formula">Ω<sub>GW</sub>[m] = Σ<sub>ij</sub> C<sub>mij</sub>A<sub>i</sub>A<sub>j</sub></div></div>
  <div class="sig-lab__toolbar">
    <div class="sig-lab__presets" role="group" aria-label="Curvature spectrum presets"><button data-preset="single">Single peak</button><button data-preset="broad">Broad peak</button><button data-preset="double">Double peak</button><button data-preset="flat">Reset</button></div>
    <label>Resolution <select data-resolution><option value="50">50 bins · standard</option><option value="100">100 bins · high resolution</option></select></label>
  </div>
  <div class="sig-lab__loading" data-loading hidden>Loading coefficient grid…</div>
  <div class="sig-lab__plots">
    <div><div class="plot-title"><span>Input</span><strong>𝒫<sub>ζ</sub>(k)</strong></div><svg data-pz viewBox="0 0 520 340" role="img" aria-label="Paintable binned primordial curvature spectrum"><g data-grid></g><path data-area></path><path data-line></path><g data-handles></g></svg><p class="hint">Drag across the plot to paint</p></div>
    <div><div class="plot-title"><span>Response</span><strong>Ω<sub>GW</sub>h²(f)</strong></div><svg data-omega viewBox="0 0 520 340" role="img" aria-label="Resulting scalar-induced gravitational-wave spectrum"><g data-grid></g><path data-response></path></svg><p class="hint">Radiation domination · precomputed coefficient grid</p></div>
  </div>
  <p class="sig-lab__note">The contraction matches <code>SIGWAY.Binned_P_zeta</code>. Coefficients and grids come from SIGWAY’s shipped <code>tabkpp*.txt</code> files; high-resolution computation runs in a browser worker and amplitudes are constrained to the displayed exploratory range.</p>
</section>
<script>
  (()=>{
    const root=document.getElementById('sigway-explorer');if(!root)return;
    const worker=new Worker('/workers/sigway-worker.js');let d:any=null,amps:number[]=[];let token=0,pending=false,active=false;
    const W=520,H=340,L=50,R=16,T=20,B=42;const pz=root.querySelector<SVGElement>('[data-pz]')!,og=root.querySelector<SVGElement>('[data-omega]')!;
    const lx=(v:number,min:number,max:number)=>L+(Math.log10(v)-Math.log10(min))/(Math.log10(max)-Math.log10(min))*(W-L-R);const ly=(v:number,min:number,max:number)=>T+(1-(Math.log10(v)-Math.log10(min))/(Math.log10(max)-Math.log10(min)))*(H-T-B);
    const grid=(svg:SVGElement,xmin:number,xmax:number,ymin:number,ymax:number)=>{const g=svg.querySelector('[data-grid]')!;g.innerHTML=[xmin,Math.sqrt(xmin*xmax),xmax].map(x=>`<line x1="${lx(x,xmin,xmax)}" y1="${T}" x2="${lx(x,xmin,xmax)}" y2="${H-B}"/><text x="${lx(x,xmin,xmax)}" y="${H-15}">${x.toExponential(0)}</text>`).join('')+[ymin,Math.sqrt(ymin*ymax),ymax].map(y=>`<line x1="${L}" y1="${ly(y,ymin,ymax)}" x2="${W-R}" y2="${ly(y,ymin,ymax)}"/><text x="4" y="${ly(y,ymin,ymax)+4}">${y.toExponential(0)}</text>`).join('');};
    const line=(xs:number[],ys:number[],xmin:number,xmax:number,ymin:number,ymax:number)=>ys.map((y,i)=>`${i?'L':'M'}${lx(xs[i],xmin,xmax).toFixed(1)},${ly(Math.max(y,ymin),ymin,ymax).toFixed(1)}`).join(' ');
    function preset(name:string){const n=amps.length;for(let i=0;i<n;i++){const q=i/(n-1);let log=-5;if(name==='single')log=-6+4*Math.exp(-.5*((q-.46)/.11)**2);if(name==='broad')log=-6+3.9*Math.exp(-.5*((q-.5)/.25)**2);if(name==='double')log=-6+3.7*Math.max(Math.exp(-.5*((q-.28)/.09)**2),Math.exp(-.5*((q-.72)/.1)**2));amps[i]=10**log;}drawInput();calculate();}
    function drawInput(){if(!d)return;const xmin=Math.min(...d.fp),xmax=Math.max(...d.fp),ymin=1e-6,ymax=1e-1;const lp=line(d.fp,amps,xmin,xmax,ymin,ymax);pz.querySelector('[data-line]')!.setAttribute('d',lp);pz.querySelector('[data-area]')!.setAttribute('d',`${lp} L${lx(xmax,xmin,xmax)},${ly(ymin,ymin,ymax)} L${lx(xmin,xmin,xmax)},${ly(ymin,ymin,ymax)} Z`);const radius=amps.length>50?2.3:amps.length>10?3.5:6;pz.querySelector('[data-handles]')!.innerHTML=amps.map((a,i)=>`<circle cx="${lx(d.fp[i],xmin,xmax)}" cy="${ly(a,ymin,ymax)}" r="${radius}"/>`).join('');}
    function calculate(){pending=true;worker.postMessage({type:'calculate',amplitudes:amps,token:++token});}
    function paint(e:PointerEvent){if(!active||!d)return;const rect=pz.getBoundingClientRect(),px=(e.clientX-rect.left)/rect.width*W,py=(e.clientY-rect.top)/rect.height*H;const q=Math.max(0,Math.min(1,(px-L)/(W-L-R))),i=Math.round(q*(amps.length-1)),exponent=-1-(Math.max(T,Math.min(H-B,py))-T)/(H-T-B)*5;amps[i]=10**exponent;drawInput();if(!pending)calculate();}
    pz.addEventListener('pointerdown',e=>{active=true;pz.setPointerCapture(e.pointerId);paint(e)});pz.addEventListener('pointermove',paint);pz.addEventListener('pointerup',()=>active=false);
    worker.onmessage=e=>{if(e.data.type==='loaded'){d=e.data.kernel;amps=Array(d.fp.length).fill(1e-5);grid(pz,Math.min(...d.fp),Math.max(...d.fp),1e-6,1e-1);grid(og,Math.min(...d.fk)/(2*Math.PI),Math.max(...d.fk)/(2*Math.PI),1e-18,1e-6);root.querySelector<HTMLElement>('[data-loading]')!.hidden=true;preset('single');}if(e.data.type==='result'){pending=false;if(e.data.token===token){og.querySelector('[data-response]')!.setAttribute('d',line(d.fk.map((k:number)=>k/(2*Math.PI)),e.data.omega,Math.min(...d.fk)/(2*Math.PI),Math.max(...d.fk)/(2*Math.PI),1e-18,1e-6));}if(active)calculate();}};
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(b=>b.addEventListener('click',()=>preset(b.dataset.preset!)));root.querySelector<HTMLSelectElement>('[data-resolution]')!.addEventListener('change',e=>{root.querySelector<HTMLElement>('[data-loading]')!.hidden=false;worker.postMessage({type:'load',nbins:Number((e.target as HTMLSelectElement).value)});});worker.postMessage({type:'load',nbins:50});
  })();
</script>
<style>
  .sig-lab{background:var(--night);color:var(--cream);padding:clamp(1.2rem,3vw,2.5rem)}.sig-lab__head{align-items:end;display:flex;gap:2rem;justify-content:space-between}.sig-lab__head>div:first-child{max-width:680px}h2{font-family:var(--serif);font-size:clamp(2rem,3.5vw,3.1rem);font-weight:400;letter-spacing:-.04em;margin:.25rem 0}.sig-lab__head p,.sig-lab__note{color:rgba(244,241,234,.55);line-height:1.6}.sig-lab__formula{border:1px solid var(--line-dark);font-family:var(--mono);font-size:.72rem;padding:.8rem;white-space:nowrap}.sig-lab__toolbar{align-items:center;display:flex;justify-content:space-between;margin:1.5rem 0}.sig-lab__presets{display:flex;flex-wrap:wrap;gap:.5rem}.sig-lab button,.sig-lab select{background:transparent;border:1px solid var(--line-dark);color:var(--cream);cursor:pointer;font-family:var(--mono);font-size:.62rem;padding:.55rem .7rem;text-transform:uppercase}.sig-lab select option{color:var(--night)}.sig-lab label{color:rgba(244,241,234,.5);font-family:var(--mono);font-size:.62rem;text-transform:uppercase}.sig-lab button:hover{border-color:var(--signal);color:var(--signal-soft)}.sig-lab__loading{color:var(--signal-soft);font-family:var(--mono);font-size:.68rem;margin:.5rem 0}.sig-lab__plots{display:grid;gap:1px;grid-template-columns:1fr 1fr}.sig-lab__plots>div{border:1px solid var(--line-dark);padding:1rem}.plot-title{align-items:baseline;display:flex;justify-content:space-between}.plot-title span,.hint{color:rgba(244,241,234,.45);font-family:var(--mono);font-size:.6rem;text-transform:uppercase}.plot-title strong{font-family:var(--serif);font-size:1.2rem;font-weight:400}svg{touch-action:none;width:100%}[data-grid] :global(line){stroke:rgba(244,241,234,.1)}[data-grid] :global(text){fill:rgba(244,241,234,.45);font-family:var(--mono);font-size:10px}[data-area]{fill:rgba(82,122,123,.16)}[data-line]{fill:none;stroke:var(--signal);stroke-width:2.5}[data-handles] :global(circle){fill:var(--cream);stroke:var(--signal);stroke-width:1.5}[data-response]{fill:none;stroke:var(--signal-soft);stroke-width:3}.hint{margin:.2rem 0 0;text-align:right}.sig-lab__note{font-size:.7rem;margin:1rem 0 0}.sig-lab__note code{color:var(--signal-soft)}@media(max-width:750px){.sig-lab__head,.sig-lab__toolbar{align-items:start;flex-direction:column}.sig-lab__plots{grid-template-columns:1fr}.sig-lab__formula{white-space:normal}}
</style>
