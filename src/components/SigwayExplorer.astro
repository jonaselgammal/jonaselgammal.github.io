---
import detectorData from '../data/detector-overlays.json';
---
<section class="sig-lab" id="sigway-explorer">
  <div class="sig-lab__head"><div><span class="eyebrow">SIGWAY kernel lab</span><h2>Paint a primordial spectrum</h2><p>Draw the binned curvature spectrum and see how pairs of scalar modes source the induced gravitational-wave signal.</p></div></div>
  <div class="sig-lab__toolbar">
    <div class="sig-lab__presets" role="group" aria-label="Curvature spectrum presets"><button data-preset="single">Single peak</button><button data-preset="broken">Broken power law</button><button data-preset="double">Double peak</button><button data-preset="flat">Reset</button></div>
    <div class="sig-lab__settings"><label>Band <select data-detector><option value="lisa">LISA</option><option value="pta">PTA</option><option value="ligo">LIGO</option><option value="none">None · LISA scale</option></select></label><label>Resolution <select data-resolution><option value="50">50 bins · standard</option><option value="100">100 bins · high resolution</option></select></label></div>
  </div>
  <div class="sig-lab__loading" data-loading hidden>Loading coefficient grid…</div>
  <div class="sig-lab__plots">
    <div><div class="plot-title"><span>Input</span><strong>𝒫<sub>ζ</sub>(k)</strong></div><svg data-pz viewBox="0 0 520 340" role="img" aria-label="Paintable binned primordial curvature spectrum"><g data-grid></g><path data-area></path><path data-line></path><g data-handles></g></svg><p class="hint">Drag across the plot to paint</p></div>
    <div><div class="plot-title"><span>Response</span><strong>Ω<sub>GW</sub>h²(f)</strong></div><svg data-omega viewBox="0 0 520 340" role="img" aria-label="Resulting scalar-induced gravitational-wave spectrum and selected detector reference"><defs><clipPath id="sigway-response-clip"><rect x="50" y="20" width="454" height="278" /></clipPath></defs><g data-grid></g><g clip-path="url(#sigway-response-clip)"><path data-sensitivity-band></path><path data-sensitivity></path><path data-response></path></g></svg><p class="hint"><span data-detector-label>LISA · 4 yr PLI</span> · radiation domination</p></div>
  </div>
  <p class="sig-lab__note">The induced spectrum is quadratic in the curvature perturbations: every output frequency receives contributions from pairs of primordial modes, so changing one bin generally reshapes a broad range of the gravitational-wave spectrum. PTA and LIGO views use the radiation-era kernel’s scale invariance to shift both frequency grids together. LISA and LIGO show power-law-integrated sensitivity curves; the PTA reference is the NANOGrav 15-year free-spectrum posterior rather than a forecast sensitivity.</p>
  <script is:inline type="application/json" data-detectors-json set:html={JSON.stringify(detectorData)}></script>
</section>
<script>
  (()=>{
    const found=document.getElementById('sigway-explorer');if(!found)return;const root=found;
    const worker=new Worker('/workers/sigway-worker.js');let d:any=null,amps:number[]=[],latestOmega:number[]=[];let token=0,pending=false,active=false,band='lisa';const detectors=JSON.parse(root.querySelector('[data-detectors-json]')?.textContent||'{}');
    const W=520,H=340,L=50,R=16,T=20,B=42;const pz=root.querySelector<SVGElement>('[data-pz]')!,og=root.querySelector<SVGElement>('[data-omega]')!;
    const lx=(v:number,min:number,max:number)=>L+(Math.log10(v)-Math.log10(min))/(Math.log10(max)-Math.log10(min))*(W-L-R);const ly=(v:number,min:number,max:number)=>T+(1-(Math.log10(v)-Math.log10(min))/(Math.log10(max)-Math.log10(min)))*(H-T-B);
    const grid=(svg:SVGElement,xmin:number,xmax:number,ymin:number,ymax:number)=>{const g=svg.querySelector('[data-grid]')!;g.innerHTML=[xmin,Math.sqrt(xmin*xmax),xmax].map(x=>`<line x1="${lx(x,xmin,xmax)}" y1="${T}" x2="${lx(x,xmin,xmax)}" y2="${H-B}"/><text x="${lx(x,xmin,xmax)}" y="${H-15}">${x.toExponential(0)}</text>`).join('')+[ymin,Math.sqrt(ymin*ymax),ymax].map(y=>`<line x1="${L}" y1="${ly(y,ymin,ymax)}" x2="${W-R}" y2="${ly(y,ymin,ymax)}"/><text x="4" y="${ly(y,ymin,ymax)+4}">${y.toExponential(0)}</text>`).join('');};
    const line=(xs:number[],ys:number[],xmin:number,xmax:number,ymin:number,ymax:number)=>ys.map((y,i)=>`${i?'L':'M'}${lx(xs[i],xmin,xmax).toFixed(1)},${ly(Math.max(y,ymin),ymin,ymax).toFixed(1)}`).join(' ');
    function preset(name:string){const n=amps.length;for(let i=0;i<n;i++){const q=i/(n-1);let amplitude=1e-5;if(name==='single')amplitude=10**(-6+4*Math.exp(-.5*((q-.46)/.11)**2));if(name==='broken'){const ratio=10**((q-.5)*6),shape=2/(ratio**-3+ratio**1.2);amplitude=1e-6+1.2e-2*shape;}if(name==='double')amplitude=10**(-6+3.7*Math.max(Math.exp(-.5*((q-.28)/.09)**2),Math.exp(-.5*((q-.72)/.1)**2)));amps[i]=amplitude;}drawInput();calculate();}
    const scale=()=>band==='none'?1:detectors[band].scale;
    function drawInput(){if(!d)return;const xs=d.fp.map((x:number)=>x*scale()),xmin=Math.min(...xs),xmax=Math.max(...xs),ymin=1e-6,ymax=1e-1;const lp=line(xs,amps,xmin,xmax,ymin,ymax);pz.querySelector('[data-line]')!.setAttribute('d',lp);pz.querySelector('[data-area]')!.setAttribute('d',`${lp} L${lx(xmax,xmin,xmax)},${ly(ymin,ymin,ymax)} L${lx(xmin,xmin,xmax)},${ly(ymin,ymin,ymax)} Z`);const radius=amps.length>50?2.3:amps.length>10?3.5:6;pz.querySelector('[data-handles]')!.innerHTML=amps.map((a,i)=>`<circle cx="${lx(xs[i],xmin,xmax)}" cy="${ly(a,ymin,ymax)}" r="${radius}"/>`).join('');}
    function drawDetector(){if(!d)return;const xs=d.fk.map((k:number)=>k/(2*Math.PI)*scale()),xmin=Math.min(...xs),xmax=Math.max(...xs),ymin=1e-18,ymax=1e-6,target=og.querySelector('[data-sensitivity]')!,area=og.querySelector('[data-sensitivity-band]')!;if(band==='none'){target.setAttribute('d','');area.setAttribute('d','');root.querySelector('[data-detector-label]')!.textContent='No detector overlay';return;}const ref=detectors[band],keep=ref.frequency.map((f:number,i:number)=>({f,y:ref.omega[i],lo:ref.lower?.[i],hi:ref.upper?.[i]})).filter((v:any)=>v.f>=xmin&&v.f<=xmax);target.setAttribute('d',line(keep.map((v:any)=>v.f),keep.map((v:any)=>v.y),xmin,xmax,ymin,ymax));if(ref.lower&&keep.length){const top=line(keep.map((v:any)=>v.f),keep.map((v:any)=>v.hi),xmin,xmax,ymin,ymax),bottom=keep.slice().reverse().map((v:any)=>`L${lx(v.f,xmin,xmax).toFixed(1)},${ly(Math.max(v.lo,ymin),ymin,ymax).toFixed(1)}`).join(' ');area.setAttribute('d',`${top} ${bottom} Z`)}else area.setAttribute('d','');root.querySelector('[data-detector-label]')!.textContent=ref.label;}
    function redrawAxes(){if(!d)return;const s=scale(),px=d.fp.map((x:number)=>x*s),ox=d.fk.map((k:number)=>k/(2*Math.PI)*s);grid(pz,Math.min(...px),Math.max(...px),1e-6,1e-1);grid(og,Math.min(...ox),Math.max(...ox),1e-18,1e-6);drawInput();drawDetector();if(latestOmega.length)og.querySelector('[data-response]')!.setAttribute('d',line(ox,latestOmega,Math.min(...ox),Math.max(...ox),1e-18,1e-6));}
    function calculate(){pending=true;worker.postMessage({type:'calculate',amplitudes:amps,token:++token});}
    function paint(e:PointerEvent){if(!active||!d)return;const rect=pz.getBoundingClientRect(),px=(e.clientX-rect.left)/rect.width*W,py=(e.clientY-rect.top)/rect.height*H;const q=Math.max(0,Math.min(1,(px-L)/(W-L-R))),i=Math.round(q*(amps.length-1)),exponent=-1-(Math.max(T,Math.min(H-B,py))-T)/(H-T-B)*5;amps[i]=10**exponent;drawInput();if(!pending)calculate();}
    function interpolateSpectrum(frequency:number[],amplitude:number[],targets:number[]){const lx=frequency.map(Math.log10),ly=amplitude.map((v:number)=>Math.log10(Math.max(v,1e-12)));return targets.map(target=>{const value=Math.log10(target);if(value<=lx[0])return 10**ly[0];if(value>=lx[lx.length-1])return 10**ly[ly.length-1];let hi=1;while(lx[hi]<value)hi++;const lo=hi-1,t=(value-lx[lo])/(lx[hi]-lx[lo]);return 10**(ly[lo]+t*(ly[hi]-ly[lo]));});}
    pz.addEventListener('pointerdown',e=>{active=true;pz.setPointerCapture(e.pointerId);paint(e)});pz.addEventListener('pointermove',paint);pz.addEventListener('pointerup',()=>active=false);
    worker.onmessage=e=>{if(e.data.type==='loaded'){d=e.data.kernel;amps=Array(d.fp.length).fill(1e-5);latestOmega=[];redrawAxes();root.querySelector<HTMLElement>('[data-loading]')!.hidden=true;preset('single');}if(e.data.type==='result'){pending=false;if(e.data.token===token){latestOmega=e.data.omega;redrawAxes();}if(active)calculate();}};
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(b=>b.addEventListener('click',()=>preset(b.dataset.preset!)));root.querySelector<HTMLSelectElement>('[data-resolution]')!.addEventListener('change',e=>{root.querySelector<HTMLElement>('[data-loading]')!.hidden=false;worker.postMessage({type:'load',nbins:Number((e.target as HTMLSelectElement).value)});});root.querySelector<HTMLSelectElement>('[data-detector]')!.addEventListener('change',e=>{band=(e.target as HTMLSelectElement).value;redrawAxes();});window.addEventListener('sigway:load-spectrum',((event:CustomEvent)=>{if(!d)return;band='lisa';root.querySelector<HTMLSelectElement>('[data-detector]')!.value='lisa';const targetFrequency=d.fp.map((k:number)=>k/(2*Math.PI));amps=interpolateSpectrum(event.detail.frequency,event.detail.amplitude,targetFrequency).map(v=>Math.max(1e-6,Math.min(1e-1,v)));latestOmega=[];redrawAxes();calculate();}) as EventListener);worker.postMessage({type:'load',nbins:50});
  })();
</script>
<style>
  .sig-lab{background:transparent;color:var(--ink);padding:clamp(1.2rem,3vw,2.5rem)}.sig-lab__head>div{max-width:760px}h2{font-family:var(--serif);font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:400;letter-spacing:-.04em;margin:.25rem 0}.sig-lab__head p,.sig-lab__note{color:var(--ink-soft);line-height:1.6}.sig-lab__toolbar{align-items:center;display:flex;gap:1rem;justify-content:space-between;margin:1.3rem 0}.sig-lab__presets,.sig-lab__settings{display:flex;flex-wrap:wrap;gap:.5rem}.sig-lab__settings{justify-content:flex-end}.sig-lab button,.sig-lab select{background:rgba(244,241,234,.48);border:1px solid var(--line);color:var(--ink);cursor:pointer;font-family:var(--mono);font-size:.62rem;padding:.55rem .7rem;text-transform:uppercase}.sig-lab label{color:var(--ink-soft);font-family:var(--mono);font-size:.62rem;text-transform:uppercase}.sig-lab button:hover,.sig-lab select:hover{border-color:var(--signal);color:var(--signal)}.sig-lab__loading{color:var(--signal);font-family:var(--mono);font-size:.68rem;margin:.5rem 0}.sig-lab__plots{align-items:start;display:grid;gap:1px;grid-template-columns:1fr 1fr}.sig-lab__plots>div{background:rgba(244,241,234,.48);border:1px solid var(--line);min-width:0;padding:1rem}.plot-title{align-items:baseline;display:flex;justify-content:space-between}.plot-title span,.hint{color:var(--ink-soft);font-family:var(--mono);font-size:.6rem;text-transform:uppercase}.plot-title strong{font-family:var(--serif);font-size:1.2rem;font-weight:400}svg{display:block;touch-action:none;width:100%}[data-grid] :global(line){stroke:rgba(24,35,40,.1)}[data-grid] :global(text){fill:rgba(24,35,40,.5);font-family:var(--mono);font-size:11px}[data-area]{fill:rgba(82,122,123,.16)}[data-line]{fill:none;stroke:var(--signal);stroke-width:2.5}[data-handles] :global(circle){fill:var(--paper);stroke:var(--signal);stroke-width:1.5}[data-sensitivity-band]{fill:rgba(168,127,104,.18);stroke:none}[data-sensitivity]{fill:none;stroke:var(--warm-signal);stroke-dasharray:4 3;stroke-width:2}[data-response]{fill:none;stroke:var(--signal);stroke-width:3}.hint{margin:.35rem 0 0;text-align:right}.sig-lab__note{font-size:.7rem;margin:1rem 0 0}.sig-lab__note code{color:var(--signal)}@media(max-width:900px){.sig-lab__toolbar{align-items:start;flex-direction:column}.sig-lab__settings{justify-content:flex-start}.sig-lab__plots{grid-template-columns:1fr}}@media(max-width:520px){.sig-lab{padding:.85rem .15rem}.sig-lab__settings{display:grid;grid-template-columns:1fr;width:100%}.sig-lab__settings label{display:grid;gap:.25rem}.sig-lab__plots>div{padding:.7rem}.sig-lab__presets button{flex:1 1 42%}[data-grid] :global(text){font-size:13px}}
</style>
