---
import BaseLayout from '../layouts/BaseLayout.astro';
const resources=[{type:'PhD thesis · 2025',title:'Cutting Edge Data Analysis for Gravitational Wave Detection with LISA',text:'Bayesian inference and data-analysis methods for LISA, including Gaussian-process acceleration and primordial-spectrum reconstruction.',href:'/assets/files/phd_thesis/main.pdf'},{type:'Master thesis · 2020',title:'Accelerating Bayesian Inference of Expensive Likelihoods with Gaussian Processes',text:'Surrogate modelling and acquisition strategies for costly likelihood evaluations.',href:'/assets/files/master_thesis/build/Masterthesis_jonas_elgammal.pdf'},{type:'Lecture notes',title:'Theory of Relativity and Cosmology',text:'A comprehensive summary of special relativity, general relativity, and homogeneous cosmology.',href:'/assets/files/GR_summary/build/ART_mothership.pdf'}];
---
<BaseLayout title="Resources — Jonas El Gammal" description="Theses, lecture notes and scientific resources by Jonas El Gammal."><header class="page-head"><div class="shell"><span class="eyebrow">Writing & teaching</span><h1>Resources</h1><p>Theses, lecture notes, and material that may be useful beyond the projects they came from.</p></div></header><section class="shell resources">{resources.map((r,i)=><a href={r.href}><span>{String(i+1).padStart(2,'0')} · {r.type}</span><h2>{r.title}</h2><p>{r.text}</p><b>Open PDF ↗</b></a>)}</section></BaseLayout>
<style>.resources{display:grid;gap:1px;grid-template-columns:repeat(3,1fr);padding-top:4rem}.resources a{border:1px solid var(--line);display:flex;flex-direction:column;min-height:390px;padding:2rem;text-decoration:none}.resources a:hover{background:var(--paper-deep)}.resources span,.resources b{font-family:var(--mono);font-size:.66rem;text-transform:uppercase}.resources span{color:var(--signal)}.resources h2{font-family:var(--serif);font-size:2rem;font-weight:400;line-height:1.06}.resources p{color:var(--ink-soft);line-height:1.65}.resources b{margin-top:auto}@media(max-width:850px){.resources{grid-template-columns:1fr}}</style>
