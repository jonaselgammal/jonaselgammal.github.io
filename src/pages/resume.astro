---
import BaseLayout from '../layouts/BaseLayout.astro';
const experience=[
  {logo:'/assets/icons/kbfi.svg',org:'KBFI / NICPB',url:'https://kbfi.ee/en/',role:'Postdoctoral researcher',years:'2026–present',text:'Cosmology, gravitational-wave inference, and scientific machine learning in Tallinn, Estonia.'},
  {logo:'/assets/icons/insubria.png',org:'University of Insubria',url:'https://www.uninsubria.eu',role:'Postdoctoral researcher',years:'2025–2026',text:'GPU-accelerated and differentiable Pulsar Timing Array inference with JAX in the EPTA collaboration.'},
  {logo:'/assets/icons/cern.png',org:'CERN Theory',url:'https://theory.cern/',role:'Visiting researcher',years:'2024',text:'Scalar-induced gravitational-wave analysis for LISA with Mauro Pieroni and Gabriele Franciolini.'},
];
const publications=[['2026','Are PTA measurements sensitive to gravitational wave non-Gaussianities?','https://arxiv.org/abs/2605.05157'],['2025','Accelerating LISA inference with Gaussian processes','https://arxiv.org/abs/2503.21871'],['2025','Reconstructing Primordial Curvature Perturbations via Scalar-Induced GWs','https://arxiv.org/abs/2501.11320'],['2023','Parallelized Acquisition for Active Learning using Monte Carlo','https://arxiv.org/abs/2305.19267'],['2022','Fast and Robust Bayesian Inference using Gaussian Processes with GPry','https://arxiv.org/abs/2211.02045']];
---
<BaseLayout title="CV — Jonas El Gammal" description="Research experience, education, publications and software by cosmologist and scientific-ML researcher Jonas El Gammal."><header class="page-head"><div class="shell"><span class="eyebrow">Curriculum vitae</span><h1>About & CV</h1><p>Cosmologist and scientific-machine-learning researcher working across Bayesian inference, gravitational waves, and reliable computational systems.</p><a class="button button--solid" href="/assets/files/CV_jonas_el_gammal.pdf">Download full CV · PDF</a></div></header><div class="shell cv"><aside><img src="/assets/img/me.jpg" alt="Jonas El Gammal"/><h2>Jonas El Gammal</h2><p>Tallinn, Estonia</p><a href="mailto:jonas.el.gammal@rwth-aachen.de">Email</a><a href="https://orcid.org/0009-0005-4833-4266">ORCID</a><a href="https://inspirehep.net/authors/2902073">INSPIRE-HEP</a><a href="https://github.com/jonaselgammal">GitHub</a><a href="https://www.linkedin.com/in/jelgammal/">LinkedIn</a></aside><div class="cv__main"><section><span class="eyebrow">Experience</span>{experience.map(x=><article class="entry"><a class="logo" href={x.url}><img src={x.logo} alt={`${x.org} logo`}/></a><div><h3>{x.role}</h3><a href={x.url}>{x.org}</a><p>{x.text}</p></div><time>{x.years}</time></article>)}</section><section><span class="eyebrow">Education</span><article class="entry"><a class="logo" href="https://www.uis.no/en"><img src="/assets/icons/uis.png" alt="University of Stavanger logo"/></a><div><h3>PhD in Physics</h3><a href="https://www.uis.no/en">University of Stavanger</a><p><em>Cutting Edge Data Analysis for Gravitational Wave Detection with LISA</em></p></div><time>2021–2025</time></article><article class="entry"><a class="logo" href="https://www.rwth-aachen.de"><img src="/assets/icons/rwth_small.png" alt="RWTH Aachen logo"/></a><div><h3>BSc and MSc in Physics</h3><a href="https://www.rwth-aachen.de">RWTH Aachen University</a><p>Astroparticle physics and cosmology; Gaussian-process acceleration of expensive Bayesian inference.</p></div><time>2015–2020</time></article></section><section><span class="eyebrow">Selected publications</span>{publications.map(p=><article class="publication"><time>{p[0]}</time><a href={p[2]}>{p[1]}</a></article>)}</section><section><span class="eyebrow">Methods & technologies</span><p class="skills">Bayesian inference · Gaussian processes · active learning · uncertainty quantification · JAX · Python · scientific software · gravitational-wave analysis · differentiable programming · simulation-based inference</p></section></div></div></BaseLayout>
<style>.page-head .button{margin-top:1rem}.cv{display:grid;gap:clamp(2.5rem,5vw,5rem);grid-template-columns:220px 1fr;padding-top:2.75rem}.cv aside img{aspect-ratio:4/3;object-fit:cover;width:100%}.cv aside h2{font-family:var(--serif);font-size:1.7rem;font-weight:400;margin-bottom:.2rem}.cv aside p{color:var(--ink-soft)}.cv aside a{display:block;font-family:var(--mono);font-size:.66rem;margin:.55rem 0;text-transform:uppercase}.cv__main section{border-top:1px solid var(--line);padding:1.2rem 0 2.25rem}.entry{align-items:start;border-bottom:1px solid var(--line);display:grid;gap:1.1rem;grid-template-columns:52px 1fr auto;padding:1.15rem 0}.logo{align-items:center;background:white;border:1px solid var(--line);display:flex;height:46px;justify-content:center;padding:7px}.logo img{max-height:100%;object-fit:contain}.entry h3{font-family:var(--serif);font-size:1.45rem;font-weight:400;margin:0 0 .15rem}.entry div>a{font-size:.78rem}.entry p,.skills{color:var(--ink-soft);font-size:.92rem;line-height:1.6}.entry time,.publication time{font-family:var(--mono);font-size:.65rem}.publication{display:grid;gap:1rem;grid-template-columns:60px 1fr;padding:.8rem 0}.skills{font-size:1rem}@media(max-width:700px){.cv{grid-template-columns:1fr}.cv aside{max-width:220px}.entry{grid-template-columns:45px 1fr}.entry time{grid-column:2}}</style>
