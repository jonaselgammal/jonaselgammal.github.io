<BaseLayout title="Research — Jonas El Gammal" description="Research in scientific machine learning, Bayesian inference, cosmology, gravitational waves, and reliable AI systems.">
  <div class="shell"><header class="page-head"><span class="eyebrow">Research</span><h1>Physics problems,<br/>computational answers.</h1><p>My work connects cosmology and gravitational-wave astronomy with statistical computation, scientific machine learning, and carefully validated software.</p></header>
  <section class="index-list">
    <ResearchRow number="01" meta="Gaussian processes · Active learning" title="Scientific ML & Bayesian inference" text="Surrogate posterior methods for expensive likelihoods, including GPry and its applications to cosmology and LISA." href="/research/scientific-ml/" visual="/assets/img/gpry_animation.gif" visualAlt="GPry animation" />
    <ResearchRow number="02" meta="PTAs · Statistics · JAX" title="Pulsar Timing Arrays" text="The limits of model-agnostic non-Gaussianity tests, plus accelerated inference and interoperable samplers." href="/research/pta/" visual="/assets/img/pta_whitening_qq.png" visualAlt="PTA whitening result" />
    <ResearchRow number="03" meta="LISA · Inflation · SIGWAY" title="Early-universe gravitational waves" text="Reconstructing primordial curvature perturbations using induced gravitational waves and physically motivated models." href="/research/early-universe/" visual="/assets/img/detector_sensitivity.svg" visualAlt="Detector sensitivity" />
    <ResearchRow number="04" meta="LLMs · Compilers · Graphs" title="Reliable AI systems" text="Typed planning, deterministic validation, local repair, and reusable execution with Graphsmith." href="/research/ai-systems/" visual="/assets/img/graphsmith_pipeline.svg" visualAlt="Graphsmith pipeline" />
  </section></div>
</BaseLayout>
