<script>
  (()=>{
    const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-lab]')];
    const panels=[...document.querySelectorAll<HTMLElement>('[data-lab-panel]')];
    const activate=(name:string)=>{buttons.forEach(button=>{const active=button.dataset.lab===name;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active));});panels.forEach(panel=>panel.hidden=panel.dataset.labPanel!==name);};
    buttons.forEach(button=>button.addEventListener('click',()=>activate(button.dataset.lab!)));
    window.addEventListener('sigway:load-spectrum',()=>activate('spectrum'));
  })();
</script>
