---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Jonas El Gammal" description="The requested page could not be found." robots="noindex, follow"><section class="lost shell"><span class="eyebrow">Error 404</span><h1>Nothing at this coordinate.</h1><p>The page may have moved during the site migration.</p><a class="button button--solid" href="/">Return home</a></section></BaseLayout><style>.lost{min-height:60vh;padding-block:clamp(6rem,14vw,12rem)}.lost h1{font-family:var(--serif);font-size:clamp(4rem,7vw,6.5rem);font-weight:400;letter-spacing:-.055em;line-height:.92;max-width:900px}.lost p{color:var(--ink-soft);margin-bottom:2rem}</style>
