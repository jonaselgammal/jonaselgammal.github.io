---
import BaseLayout from '../layouts/BaseLayout.astro';
const schema={"@context":"https://schema.org","@type":"ProfilePage","mainEntity":{"@type":"Person","@id":"https://jonaselgammal.github.io/#jonas-el-gammal","name":"Jonas El Gammal","jobTitle":"Postdoctoral Researcher","affiliation":{"@type":"Organization","name":"National Institute of Chemical Physics and Biophysics","alternateName":"KBFI/NICPB","url":"https://kbfi.ee/en/"},"sameAs":["https://orcid.org/0009-0005-4833-4266","https://inspirehep.net/authors/2902073","https://github.com/jonaselgammal","https://www.linkedin.com/in/jelgammal/"]}};
---
<BaseLayout schema={schema}>
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <h1>Hi, I’m Jonas!</h1>
        <p class="home-hero__line">I make slow-to-compute problems fast.</p>
        <p class="home-hero__bio">I’m a cosmologist and scientific-machine-learning researcher developing methods and software for Bayesian inference and gravitational-wave astronomy. I’m currently a postdoc at <a href="https://kbfi.ee/en/">KBFI/NICPB</a> in Tallinn.</p>
        <div class="home-hero__actions"><a class="button button--solid" href="/research/">Explore research <span>→</span></a><a class="button" href="/resume/">About & CV</a></div>
      </div>
      <div class="home-hero__portrait"><img src="/assets/img/me.jpg" alt="Jonas El Gammal" width="4032" height="3024"/></div>
    </div>
  </section>

  <section class="home-personal shell"><span class="eyebrow">Beyond the screen</span><p>Most of the time I’m a pretty chill dude. Outside work, I’m usually hiking, climbing, skiing, surfing, skydiving, or finding another questionable way to spend time in the mountains. I also make jewellery, which I share at <a href="https://www.instagram.com/jeg_jewellery/">@jeg_jewellery</a>.</p></section>
</BaseLayout>
<style>
  .home-hero{border-bottom:1px solid var(--line);padding-block:clamp(3rem,7vw,6.5rem)}.home-hero__grid{align-items:center;display:grid;gap:clamp(2.5rem,6vw,6rem);grid-template-columns:1.3fr .7fr}.home-hero h1{font-family:var(--serif);font-size:clamp(3.2rem,4.7vw,4.25rem);font-weight:400;letter-spacing:-.05em;line-height:.94;margin:0 0 1.8rem}.home-hero__line{color:var(--signal);font-family:var(--serif);font-size:clamp(1.5rem,2.3vw,2.2rem);font-style:italic;margin:0 0 1.3rem}.home-hero__bio{color:var(--ink-soft);font-size:1rem;line-height:1.75;max-width:650px}.home-hero__actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.home-hero__portrait{justify-self:end;max-width:360px;position:relative}.home-hero__portrait:before{border:1px solid var(--signal);content:"";inset:-12px 12px 12px -12px;position:absolute}.home-hero__portrait img{filter:saturate(.85);height:auto;position:relative;width:100%}.home-personal{padding:3rem 0;text-align:center}.home-personal p{font-family:var(--serif);font-size:clamp(1.08rem,1.6vw,1.35rem);line-height:1.55;margin:1rem auto;max-width:900px}@media(max-width:750px){.home-hero__grid{grid-template-columns:1fr}.home-hero__portrait{justify-self:start;max-width:230px;order:-1}.home-hero h1{font-size:clamp(3.2rem,14vw,4.25rem)}}
</style>
