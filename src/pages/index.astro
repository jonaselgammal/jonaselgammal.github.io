---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchRow from '../components/ResearchRow.astro';
import GPryExplorer from '../components/GPryExplorer.astro';
const schema={"@context":"https://schema.org","@type":"ProfilePage","mainEntity":{"@type":"Person","@id":"https://jonaselgammal.github.io/#jonas-el-gammal","name":"Jonas El Gammal","jobTitle":"Postdoctoral Researcher","affiliation":{"@type":"Organization","name":"National Institute of Chemical Physics and Biophysics","alternateName":"KBFI/NICPB","url":"https://kbfi.ee/en/"},"sameAs":["https://orcid.org/0009-0005-4833-4266","https://inspirehep.net/authors/2902073","https://github.com/jonaselgammal","https://www.linkedin.com/in/jelgammal/"]}};
---
<BaseLayout schema={schema}>
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <span class="eyebrow">Cosmology × inference × machine intelligence</span>
        <h1>Hi, I’m Jonas!</h1>
        <p class="home-hero__line">I make slow-to-compute problems fast.</p>
        <p class="home-hero__bio">I’m a cosmologist and scientific-machine-learning researcher developing methods and software for Bayesian inference and gravitational-wave astronomy. I’m currently a postdoc at <a href="https://kbfi.ee/en/">KBFI/NICPB</a> in Tallinn.</p>
        <div class="home-hero__actions"><a class="button button--solid" href="/research/">Explore research <span>→</span></a><a class="button" href="/resume/">About & CV</a></div>
      </div>
      <div class="home-hero__portrait"><img src="/assets/img/me.jpg" alt="Jonas El Gammal" width="4032" height="3024"/><span>Jonas El Gammal · Tallinn, Estonia</span></div>
    </div>
    <div class="home-hero__index shell"><span>Gaussian processes</span><span>Active learning</span><span>PTA statistics</span><span>Early universe</span><span>Reliable AI</span></div>
  </section>

  <section class="home-research shell">
    <header class="home-section-head"><div><span class="eyebrow">Research index</span><h2>Selected directions</h2></div><p>Methods, evidence, and open-source implementations. Each area has its own focused research page.</p></header>
    <ResearchRow number="01" meta="Scientific ML · Bayesian inference" title="Learning expensive posteriors" text="Gaussian-process surrogates and active learning for inference when every likelihood evaluation is costly." href="/research/scientific-ml/" visual="/assets/img/gpry_animation.gif" visualAlt="GPry active-learning animation" />
    <ResearchRow number="02" meta="Latest paper · Under review" title="What can PTA statistics really tell us?" text="Whitening, scale estimation, and why broad PTA responses wash out model-agnostic non-Gaussian signatures." href="/research/pta/" visual="/assets/img/pta_ng_whitening_v2.svg" visualAlt="PTA whitening calibration from the latest arXiv version" />
    <ResearchRow number="03" meta="LISA · Primordial signals" title="Reconstructing the early universe" text="Scalar-induced gravitational waves as a probe of primordial curvature perturbations and inflationary dynamics." href="/research/early-universe/" visual="/assets/img/detector_sensitivity.svg" visualAlt="Gravitational-wave detector sensitivity" />
    <ResearchRow number="04" meta="Typed planning · Execution" title="Reliable AI systems" text="Graphsmith separates semantic planning from deterministic compilation, validation, repair, and execution." href="/research/ai-systems/" visual="/assets/img/graphsmith_pipeline.svg" visualAlt="Graphsmith pipeline" />
  </section>

  <section class="home-lab">
    <div class="shell"><header class="home-section-head home-section-head--dark"><div><span class="eyebrow">Interactive lab · GPry</span><h2>Inference as something you can inspect</h2></div><p>This is a replay of precomputed states—not a decorative animation. Step through how the surrogate’s uncertainty directs the next expensive evaluation.</p></header><GPryExplorer compact={true}/><a class="lab-link" href="/lab/gpry/">Open the full explainer <span>→</span></a></div>
  </section>

  <section class="home-personal shell"><span class="eyebrow">Beyond the screen</span><p>Most of the time I’m a pretty chill dude. Outside work, I’m usually hiking, climbing, skiing, surfing, skydiving, or finding another questionable way to spend time in the mountains.</p></section>
</BaseLayout>
<style>
  .home-hero{border-bottom:1px solid var(--line);padding-top:clamp(3rem,8vw,8rem)}.home-hero__grid{align-items:center;display:grid;gap:clamp(3rem,8vw,8rem);grid-template-columns:1.3fr .7fr}.home-hero h1{font-family:var(--serif);font-size:clamp(4.2rem,7.5vw,7rem);font-weight:400;letter-spacing:-.065em;line-height:.84;margin:1.45rem 0 1.8rem}.home-hero__line{color:var(--signal);font-family:var(--serif);font-size:clamp(1.7rem,2.8vw,2.7rem);font-style:italic;margin:0 0 1.3rem}.home-hero__bio{color:var(--ink-soft);font-size:1rem;line-height:1.75;max-width:650px}.home-hero__actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.home-hero__portrait{justify-self:end;max-width:360px;position:relative}.home-hero__portrait:before{border:1px solid var(--signal);content:"";inset:-12px 12px 12px -12px;position:absolute}.home-hero__portrait img{filter:saturate(.85);height:auto;position:relative;width:100%}.home-hero__portrait span{display:block;font-family:var(--mono);font-size:.62rem;margin-top:.75rem;text-transform:uppercase}.home-hero__index{display:flex;gap:clamp(1rem,3vw,3rem);margin-top:clamp(3rem,7vw,6rem);overflow-x:auto;padding-block:1rem}.home-hero__index span{font-family:var(--mono);font-size:.62rem;white-space:nowrap}.home-research{padding-block:clamp(5rem,10vw,9rem)}.home-section-head{align-items:end;display:grid;gap:2rem;grid-template-columns:1.2fr .8fr;margin-bottom:2.5rem}.home-section-head h2{font-family:var(--serif);font-size:clamp(2.7rem,5vw,4.5rem);font-weight:400;letter-spacing:-.05em;line-height:.94;margin:.7rem 0 0}.home-section-head p{color:var(--ink-soft);font-size:.9rem;line-height:1.65;margin:0}.home-lab{background:var(--night);color:var(--cream);padding:clamp(5rem,10vw,9rem) 0}.home-section-head--dark p{color:rgba(244,241,234,.55)}.lab-link{border-top:1px solid var(--line-dark);display:flex;font-family:var(--mono);font-size:.72rem;justify-content:space-between;padding:1.1rem 0;text-decoration:none;text-transform:uppercase}.lab-link:hover{color:var(--signal-soft)}.home-personal{border-top:1px solid var(--line);margin-top:8rem;padding:3rem 0;text-align:center}.home-personal p{font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.4rem);line-height:1.4;margin:1rem auto;max-width:850px}@media(max-width:750px){.home-hero__grid{grid-template-columns:1fr}.home-hero__portrait{justify-self:start;max-width:230px;order:-1}.home-hero h1{font-size:clamp(4rem,22vw,7rem)}.home-section-head{grid-template-columns:1fr}}
</style>
