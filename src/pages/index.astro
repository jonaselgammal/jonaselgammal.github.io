---
import BaseLayout from '../layouts/BaseLayout.astro';
const schema={"@context":"https://schema.org","@graph":[{"@type":"ProfilePage","@id":"https://jonaselgammal.github.io/#profile","url":"https://jonaselgammal.github.io/","name":"Jonas El Gammal — technology founder, quantitative researcher and scientific ML developer","mainEntity":{"@id":"https://jonaselgammal.github.io/#jonas-el-gammal"}},{"@type":"Organization","@id":"https://jonaselgammal.github.io/projects/#bright-interface","name":"Bright Interface GmbH","description":"Healthcare software company building integrated data, automation, analytics and AI systems for medical practices in Germany."},{"@type":"Person","@id":"https://jonaselgammal.github.io/#jonas-el-gammal","name":"Jonas El Gammal","url":"https://jonaselgammal.github.io/","image":"https://jonaselgammal.github.io/assets/img/me.jpg","jobTitle":["Co-founder, Managing Director and CTO","Postdoctoral Researcher"],"description":"Technology founder, quantitative researcher and scientific software developer working across healthcare software, probabilistic machine learning, Bayesian inference and computational physics.","founder":{"@id":"https://jonaselgammal.github.io/projects/#bright-interface"},"worksFor":[{"@id":"https://jonaselgammal.github.io/projects/#bright-interface"},{"@type":"Organization","name":"National Institute of Chemical Physics and Biophysics","alternateName":"KBFI / NICPB","url":"https://kbfi.ee/en/"}],"alumniOf":[{"@type":"CollegeOrUniversity","name":"University of Stavanger"},{"@type":"CollegeOrUniversity","name":"RWTH Aachen University"}],"knowsAbout":["healthcare software","data integration","workflow automation","applied artificial intelligence","Bayesian inference","probabilistic machine learning","Gaussian processes","active learning","uncertainty quantification","JAX","scientific software","cosmology","gravitational-wave astronomy"],"sameAs":["https://orcid.org/0009-0005-4833-4266","https://inspirehep.net/authors/2902073","https://github.com/jonaselgammal","https://www.linkedin.com/in/jelgammal/"]}]};
---
<BaseLayout title="Jonas El Gammal — Technology Founder, Quantitative Research & Scientific ML" description="Jonas El Gammal is a technology founder, quantitative researcher and scientific software developer working across healthcare software, probabilistic machine learning, Bayesian inference and computational physics." schema={schema} type="profile">
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <h1>Hi, I’m Jonas!</h1>
        <p class="home-hero__line">I turn complex data into systems that work.</p>
        <p class="home-hero__bio">I’m a quantitative researcher, scientific software developer, and co-founder of <a href="/projects/#bright-interface">Bright Interface GmbH</a>, where I serve as Managing Director and CTO. I lead the development of integrated data, automation, and AI systems for medical practices while continuing my research in probabilistic machine learning, Bayesian inference, and cosmology as a postdoc at <a href="https://kbfi.ee/en/">KBFI/NICPB</a> in Tallinn.</p>
        <div class="home-hero__actions"><a class="button button--solid" href="/research/">Explore research <span>→</span></a><a class="button" href="/software/">Explore software</a><a class="button" href="/resume/">About & CV</a></div>
      </div>
      <div class="home-hero__portrait"><img src="/assets/img/me.jpg" alt="Jonas El Gammal" width="4032" height="3024"/></div>
    </div>
  </section>

  <section class="home-profile shell" aria-labelledby="profile-heading">
    <div class="home-profile__intro"><h2 id="profile-heading">From mathematical model to usable software.</h2><p>My work usually starts with a complex, fragmented, or statistically difficult problem and ends with a system that can be tested, documented, and used. That applies both to scientific inference and to operational software: understanding uncertain data, designing reliable computational methods, and turning them into tools that work in practice. I am also interested in how neural networks learn internal representations, what those representations encode, and how understanding them can make AI systems more interpretable and reliable.</p></div>
    <div class="home-profile__grid">
      <article><span>01</span><h3>Probabilistic modelling</h3><p>Bayesian inference, Gaussian processes, active learning, uncertainty quantification, and simulation-based reasoning.</p></article>
      <article><span>02</span><h3>Computational methods</h3><p>JAX and Python implementations, differentiable models, accelerator-aware numerical work, and reproducible analysis pipelines.</p></article>
      <article><span>03</span><h3>Research software</h3><p>Open-source packages with documented interfaces, validation, releases, and interactive explanations of the underlying methods.</p></article>
      <article><span>04</span><h3>Product & technology leadership</h3><p>Data integration, workflow automation, applied AI, and engineering systems designed around real users and operational constraints.</p></article>
    </div>
  </section>

  <section class="home-personal shell"><span class="eyebrow">Beyond the screen</span><p>Most of the time I’m a pretty chill dude. Outside work, I’m usually hiking, climbing, skiing, surfing, skydiving, or finding another questionable way to spend time in the mountains. I also make jewellery, which I share at <a href="https://www.instagram.com/jeg_jewellery/">@jeg_jewellery</a>.</p></section>
</BaseLayout>
<style>
  .home-hero{border-bottom:1px solid var(--line);padding-block:clamp(3rem,7vw,6.5rem)}.home-hero__grid{align-items:center;display:grid;gap:clamp(2.5rem,6vw,6rem);grid-template-columns:1.3fr .7fr}.home-hero h1{font-family:var(--serif);font-size:clamp(3.2rem,4.7vw,4.25rem);font-weight:400;letter-spacing:-.05em;line-height:.94;margin:0 0 1.8rem}.home-hero__line{color:var(--signal);font-family:var(--serif);font-size:clamp(1.5rem,2.3vw,2.2rem);font-style:italic;margin:0 0 1.3rem}.home-hero__bio{color:var(--ink-soft);font-size:1rem;line-height:1.75;max-width:680px}.home-hero__actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.home-hero__portrait{justify-self:end;max-width:360px;position:relative}.home-hero__portrait:before{border:1px solid var(--signal);content:"";inset:-12px 12px 12px -12px;position:absolute}.home-hero__portrait img{filter:saturate(.85);height:auto;position:relative;width:100%}.home-profile{padding-block:clamp(3rem,6vw,5.5rem)}.home-profile__intro{max-width:900px}.home-profile h2{font-family:var(--serif);font-size:clamp(1.8rem,2.8vw,2.7rem);font-weight:400;letter-spacing:-.035em;line-height:1.08;margin:0}.home-profile__intro p,.home-profile article p{color:var(--ink-soft);line-height:1.65;margin:1rem 0 0}.home-profile__grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:2.75rem}.home-profile article{border:1px solid var(--line);padding:1.4rem}.home-profile article+article{border-left:0}.home-profile article>span{color:var(--signal);font-family:var(--mono);font-size:.65rem;text-transform:uppercase}.home-profile h3{font-family:var(--serif);font-size:1.35rem;font-weight:400;margin:.8rem 0 .55rem}.home-profile article p{font-size:.88rem;margin:0}.home-personal{border-top:1px solid var(--line);padding:3rem 0;text-align:center}.home-personal p{font-family:var(--serif);font-size:clamp(1.08rem,1.6vw,1.35rem);line-height:1.55;margin:1rem auto;max-width:900px}@media(max-width:1000px){.home-profile__grid{grid-template-columns:repeat(2,1fr)}.home-profile article:nth-child(3){border-left:1px solid var(--line);border-top:0}.home-profile article:nth-child(4){border-top:0}}@media(max-width:650px){.home-profile__grid{grid-template-columns:1fr}.home-profile article+article{border-left:1px solid var(--line);border-top:0}}@media(max-width:750px){.home-hero__grid{grid-template-columns:1fr}.home-hero__portrait{justify-self:start;max-width:230px;order:-1}.home-hero h1{font-size:clamp(3.2rem,14vw,4.25rem)}}
</style>
