---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign indexed_pages = site.pages | where_exp: "item", "item.url != nil" -%}
{%- for item in indexed_pages -%}
  {%- unless item.url contains '/assets/' or item.url == '/feed.xml' or item.url == '/robots.txt' or item.url == '/sitemap.xml' or item.sitemap == false -%}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
  </url>
  {%- endunless -%}
{%- endfor -%}
</urlset>
